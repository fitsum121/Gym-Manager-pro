# Production Environment Variables Template
# Copy this file and fill in with your production values
# NEVER commit the actual .env.production file to git!

PORT=3000

# Admin credentials - CHANGE THESE!
ADMIN_EMAIL=your-production-email@example.com
ADMIN_PASSWORD=your-secure-password-here

# Secrets - Generate new ones using: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
LICENSE_SECRET=generate-new-secret-min-64-chars
JWT_SECRET=generate-new-secret-min-64-chars

# Database - Use your production database URL
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# CORS - Comma-separated list of allowed origins for production
# Example: https://admin.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# Optional: Set to 'production' in production environment
NODE_ENV=production
