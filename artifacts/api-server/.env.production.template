# Production Environment Variables — API Server
# Set these in your hosting provider's dashboard (e.g. Render env vars).
# NEVER commit this file with real values to git.

PORT=3000
NODE_ENV=production

# Admin credentials — used to seed the first admin on first startup only.
# After seeding, change the password via the admin panel Settings tab.
ADMIN_EMAIL=your-production-email@example.com
ADMIN_PASSWORD=your-secure-password-min-12-chars

# Generate fresh secrets for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# LICENSE_SECRET must match the value in artifacts/gym-manager/lib/license.ts
LICENSE_SECRET=generate-new-secret-min-48-chars-base64

# JWT_SECRET signs all auth tokens. Changing it logs out all users.
JWT_SECRET=generate-new-secret-min-48-chars-base64

# PostgreSQL connection string from your DB provider (Aiven, Neon, Supabase, etc.)
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# Comma-separated browser origins allowed in production.
# Leave empty if you only use the mobile app (no browser admin panel access needed).
# Example: https://admin.yourdomain.com
ALLOWED_ORIGINS=
