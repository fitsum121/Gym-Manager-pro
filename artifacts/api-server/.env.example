PORT=3000

# Admin credentials for initial setup
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-strong-password-min-12-chars

# Secrets - Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must match the LICENSE_SECRET hardcoded in artifacts/gym-manager/lib/license.ts
LICENSE_SECRET=your-secret-key-min-64-chars-base64
# Secret for signing JWT tokens — use a long random string
JWT_SECRET=your-jwt-secret-min-64-chars-base64

# Database connection string
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# Comma-separated list of allowed browser origins (only enforced when NODE_ENV=production).
# The mobile app is not a browser so it is unaffected by this setting.
# Example: https://admin.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# Optional: Set to 'production' in production
NODE_ENV=development
