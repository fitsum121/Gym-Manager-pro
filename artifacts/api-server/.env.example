PORT=3000

# Admin credentials — used to seed the first admin account on first startup.
# After the first run, credentials are stored in the DB (bcrypt hashed).
# Change these before deploying to production.
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-strong-password-min-12-chars

# Secrets — generate fresh values for production using:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# LICENSE_SECRET must match the value hardcoded in artifacts/gym-manager/lib/license.ts
# If you change it, existing activation codes will stop working.
LICENSE_SECRET=your-license-secret-min-48-chars-base64

# JWT_SECRET signs auth tokens. Changing it invalidates all active sessions.
JWT_SECRET=your-jwt-secret-min-48-chars-base64

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# Comma-separated list of allowed browser origins (only enforced when NODE_ENV=production).
# The mobile app is not a browser so it is unaffected by this setting.
# Example: https://admin.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# Set to 'production' in production environments
NODE_ENV=development
